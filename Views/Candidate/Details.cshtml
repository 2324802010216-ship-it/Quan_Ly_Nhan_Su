@model Candidate
@{ ViewData["Title"] = "Ứng viên: " + Model.HoTen; }
<div class="page-header"><h1><i class="fas fa-user"></i> @Model.HoTen</h1></div>
<div class="card" style="max-width:600px"><div class="card-body">
    <p><strong>Email:</strong> @(Model.Email ?? "—")</p><p><strong>SĐT:</strong> @(Model.SDT ?? "—")</p>
    <p><strong>Ngày ứng tuyển:</strong> @Model.NgayUngTuyen.ToString("dd/MM/yyyy")</p>
    <p><strong>Trạng thái:</strong> <span class="badge bg-info">@Model.TrangThai.GetDisplayName()</span></p>
    @if(Model.CVFilePath!=null){<a href="@Model.CVFilePath" target="_blank" class="btn btn-outline-primary mt-2"><i class="fas fa-file-pdf me-1"></i>Xem CV</a>}
    <hr/><form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
        <select name="trangThai" class="form-select" style="max-width:200px">@foreach(var s in Enum.GetValues<TrangThaiUngVien>()){<option value="@s" selected="@(Model.TrangThai==s)">@s.GetDisplayName()</option>}</select>
        <button class="btn btn-primary"><i class="fas fa-save me-1"></i>Cập nhật</button>
    </form>
</div></div>
