@model List<Attendance>
@{ ViewData["Title"] = "Chấm công"; }
<div class="page-header text-reveal-stagger"><h1><i class="fas fa-calendar-check"></i> <span>Chấm công</span></h1><div class="d-flex gap-2">
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Chấm công</a>
    <a asp-action="MonthlyReport" class="btn btn-outline-secondary"><i class="fas fa-chart-bar me-1"></i>Báo cáo tháng</a>
</div></div>
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end">
    <div class="col-auto"><label>Tháng</label><input type="number" name="thang" value="@ViewBag.Thang" min="1" max="12" class="form-control" /></div>
    <div class="col-auto"><label>Năm</label><input type="number" name="nam" value="@ViewBag.Nam" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-primary"><i class="fas fa-filter"></i> Lọc</button></div>
</form></div></div>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0"><thead><tr><th>Ngày</th><th>NV</th><th>Giờ vào</th><th>Giờ ra</th><th>Số giờ</th><th>Trạng thái</th><th>Ghi chú</th><th></th></tr></thead>
<tbody>@foreach(var a in Model){<tr class="stagger-item"><td>@a.Ngay.ToString("dd/MM")</td><td>@a.Employee.HoTen</td><td>@a.GioVao</td><td>@a.GioRa</td>
<td>@(a.SoGioLam?.ToString("F1")??"—")</td><td><span class="badge @(a.TrangThai==TrangThaiChamCong.DungGio?"bg-success":a.TrangThai==TrangThaiChamCong.TreMuon?"bg-warning":"bg-secondary")">@a.TrangThai.GetDisplayName()</span></td><td>@a.GhiChu</td>
<td class="text-end"><a asp-action="Details" asp-route-id="@a.Id" class="btn-action"><i class="fas fa-eye"></i></a><a asp-action="Edit" asp-route-id="@a.Id" class="btn-action"><i class="fas fa-edit"></i></a>
<button class="btn-action danger" onclick="confirmDelete('@a.Employee.HoTen','@Url.Action("DeleteConfirmed",new{id=a.Id})')"><i class="fas fa-trash"></i></button></td></tr>}</tbody></table></div></div>
@if((int?)ViewBag.TotalPages>1){<nav class="mt-3"><ul class="pagination justify-content-center">@for(int i=1;i<=(int)ViewBag.TotalPages;i++){<li class="page-item @(i==(int)ViewBag.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-thang="@ViewBag.Thang" asp-route-nam="@ViewBag.Nam">@i</a></li>}</ul></nav>}
