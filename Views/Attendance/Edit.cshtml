@model Attendance
@{ ViewData["Title"] = "Sửa chấm công"; }
<div class="page-header"><h1><i class="fas fa-calendar-check"></i> Sửa chấm công</h1></div>
<div class="card" style="max-width:500px"><div class="card-body">
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group mb-3"><label asp-for="EmployeeId"></label><select asp-for="EmployeeId" class="form-select" asp-items="@ViewBag.Employees" disabled></select><input type="hidden" asp-for="EmployeeId" /></div>
    <div class="form-group mb-3"><label asp-for="Ngay"></label><input asp-for="Ngay" type="date" class="form-control" /></div>
    <div class="row mb-3"><div class="col"><label asp-for="GioVao"></label><input asp-for="GioVao" type="time" class="form-control" /></div>
    <div class="col"><label asp-for="GioRa"></label><input asp-for="GioRa" type="time" class="form-control" /></div></div>
    <div class="form-group mb-3"><label asp-for="TrangThai"></label><select asp-for="TrangThai" asp-items="Html.GetEnumSelectList<TrangThaiChamCong>()" class="form-select"></select></div>
    <div class="form-group mb-3"><label asp-for="GhiChu"></label><input asp-for="GhiChu" class="form-control" /></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Lưu</button><a asp-action="Index" class="btn btn-secondary">Hủy</a></div>
</form></div></div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
