@model ProfileViewModel
@{ ViewData["Title"] = "Hồ sơ"; }
<div class="page-header"><h1><i class="fas fa-user"></i> Hồ sơ cá nhân</h1></div>
<div class="row g-4" style="max-width:700px">
    <div class="col-md-5 stagger-item"><div class="card"><div class="card-body text-center">
        <img src="@(Model.AvatarUrl ?? "/images/default-avatar.png")" class="rounded-circle mb-3" width="120" height="120" style="object-fit:cover" />
        <h5>@Model.HoTen</h5><p class="text-muted">@Model.Email</p>
        <form asp-action="UpdateAvatar" method="post" enctype="multipart/form-data" class="mt-3">
            <input type="file" name="avatar" accept="image/*" class="form-control mb-2" /><button class="btn btn-primary w-100"><i class="fas fa-upload me-1"></i>Cập nhật ảnh</button>
        </form>
        <hr/><a asp-action="ChangePassword" class="btn btn-outline-secondary w-100"><i class="fas fa-key me-1"></i>Đổi mật khẩu</a>
    </div></div></div>
    <div class="col-md-7 stagger-item"><div class="card"><div class="card-header"><h6>Thông tin nhân viên</h6></div><div class="card-body">
        @if(Model.EmployeeId.HasValue){
        <p><strong>Họ tên:</strong> @Model.EmployeeName</p>
        <p><strong>Phòng ban:</strong> <span class="badge bg-primary">@Model.DepartmentName</span></p>
        <p><strong>Chức vụ:</strong> <span class="badge bg-info">@Model.PositionName</span></p>
        } else {
        <p class="text-muted"><i class="fas fa-info-circle me-1"></i>Tài khoản chưa liên kết nhân viên.</p>
        }
    </div></div></div>
</div>
