@model ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="page-header"><h1><i class="fas fa-key"></i> Đổi mật khẩu</h1></div>
<div class="card" style="max-width:400px"><div class="card-body">
<form asp-action="ChangePassword" method="post">
    <div class="form-group mb-3"><label>Mật khẩu hiện tại</label><input asp-for="CurrentPassword" type="password" class="form-control" required /></div>
    <div class="form-group mb-3"><label>Mật khẩu mới</label><input asp-for="NewPassword" type="password" class="form-control" required /></div>
    <div class="form-group mb-3"><label>Xác nhận mật khẩu mới</label><input asp-for="ConfirmPassword" type="password" class="form-control" required /></div>
    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-save me-1"></i>Đổi mật khẩu</button>
</form></div></div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
