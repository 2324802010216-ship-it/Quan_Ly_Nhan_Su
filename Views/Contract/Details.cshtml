@model Contract
@{ ViewData["Title"] = "Chi tiết hợp đồng"; }
<div class="page-header"><h1><i class="fas fa-file-contract"></i> @Model.MaHopDong</h1><div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fas fa-edit me-1"></i>Sửa</a>
    @if(Model.TrangThai==TrangThaiHopDong.HieuLuc){<form asp-action="Renew" asp-route-id="@Model.Id" method="post"><button class="btn btn-success"><i class="fas fa-redo me-1"></i>Gia hạn</button></form>}
    @if(Model.TrangThai!=TrangThaiHopDong.HieuLuc){<button class="btn btn-danger" onclick="confirmDelete('@Model.MaHopDong','@Url.Action("DeleteConfirmed",new{id=Model.Id})')"><i class="fas fa-trash me-1"></i>Xóa</button>}
</div></div>
<div class="card" style="max-width:600px"><div class="card-body">
    <p><strong>Nhân viên:</strong> <a asp-controller="Employee" asp-action="Details" asp-route-id="@Model.EmployeeId">@Model.Employee.HoTen</a></p>
    <p><strong>Loại:</strong> @Model.LoaiHopDong.GetDisplayName()</p>
    <p><strong>Lương:</strong> @Model.LuongHopDong.ToString("N0") ₫</p>
    <p><strong>Bắt đầu:</strong> @Model.NgayBatDau.ToString("dd/MM/yyyy")</p>
    <p><strong>Kết thúc:</strong> @(Model.NgayKetThuc?.ToString("dd/MM/yyyy")??"Không thời hạn")</p>
    <p><strong>Trạng thái:</strong> <span class="badge @(Model.TrangThai==TrangThaiHopDong.HieuLuc?"bg-success":"bg-secondary")">@Model.TrangThai.GetDisplayName()</span></p>
    @if(Model.SoNgayConLai.HasValue){<p><strong>Còn lại:</strong> <span class="badge bg-warning">@Model.SoNgayConLai ngày</span></p>}
</div></div>
