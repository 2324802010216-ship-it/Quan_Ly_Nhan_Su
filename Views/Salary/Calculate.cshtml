@model SalaryCalculationViewModel
@{ ViewData["Title"] = "Tính lương"; }
<div class="page-header"><h1><i class="fas fa-calculator"></i> Tính lương</h1></div>
<div class="card" style="max-width:500px"><div class="card-body">
<form asp-action="Calculate" method="post">
    <div class="form-group mb-3"><label>Nhân viên</label><select asp-for="EmployeeId" class="form-select"><option value="">-- Chọn --</option>@foreach(var e in Model.Employees!){<option value="@e.Id">@e.MaNV - @e.HoTen</option>}</select></div>
    <div class="row mb-3"><div class="col"><label asp-for="Thang"></label><input asp-for="Thang" type="number" min="1" max="12" class="form-control" /></div>
    <div class="col"><label asp-for="Nam"></label><input asp-for="Nam" type="number" class="form-control" /></div></div>
    <div class="form-group mb-3"><label asp-for="PhuCap"></label><input asp-for="PhuCap" type="number" class="form-control" placeholder="0" /></div>
    <div class="form-group mb-3"><label>Số giờ tăng ca</label><input asp-for="SoGioTangCa" type="number" step="0.5" class="form-control" placeholder="0" /></div>
    <div class="form-group mb-3"><label asp-for="KhauTru"></label><input asp-for="KhauTru" type="number" class="form-control" placeholder="0" /></div>
    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-calculator me-1"></i>Tính lương</button>
</form></div></div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
