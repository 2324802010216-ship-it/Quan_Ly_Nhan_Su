@model List<Salary>
@{ ViewData["Title"] = "Bảng lương"; }
<div class="page-header text-reveal-stagger"><h1><i class="fas fa-money-bill-wave"></i> <span>Bảng lương T@(ViewBag.Thang)/@(ViewBag.Nam)</span></h1>
<a asp-action="Calculate" class="btn btn-primary btn-magnetic"><span class="btn-text"><i class="fas fa-calculator"></i> Tính lương</span></a></div>
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end">
    <div class="col-auto"><input type="number" name="thang" value="@ViewBag.Thang" min="1" max="12" class="form-control" /></div>
    <div class="col-auto"><input type="number" name="nam" value="@ViewBag.Nam" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-primary"><i class="fas fa-filter"></i></button></div>
</form></div></div>
<div class="card"><div class="card-body p-0">
<div style="overflow-x:auto"><table class="table table-hover mb-0"><thead><tr><th>Mã NV</th><th>Họ tên</th><th>Lương CB</th><th>Phụ cấp</th><th>Tăng ca</th><th>BHXH</th><th>Khấu trừ</th><th>Thực lãnh</th><th></th></tr></thead>
<tbody>@foreach(var s in Model){<tr class="stagger-item"><td>@s.Employee.MaNV</td><td>@s.Employee.HoTen</td><td>@s.LuongCoBan.ToString("N0")</td><td>@s.PhuCap.ToString("N0")</td><td>@s.TangCa.ToString("N0")</td>
<td>@((s.BHXH+s.BHYT+s.BHTN).ToString("N0"))</td><td>@s.KhauTru.ToString("N0")</td><td><strong>@s.ThucLanh.ToString("N0")₫</strong></td>
<td><a asp-action="PaySlip" asp-route-id="@s.Id" class="btn-action" data-tooltip="Phiếu lương"><i class="fas fa-receipt"></i></a><a asp-action="Edit" asp-route-id="@s.Id" class="btn-action"><i class="fas fa-edit"></i></a>
<button class="btn-action danger" onclick="confirmDelete('@s.Employee.HoTen','@Url.Action("DeleteConfirmed",new{id=s.Id})')"><i class="fas fa-trash"></i></button></td></tr>}</tbody></table></div></div></div>
@if((int?)ViewBag.TotalPages>1){<nav class="mt-3"><ul class="pagination justify-content-center">@for(int i=1;i<=(int)ViewBag.TotalPages;i++){<li class="page-item @(i==(int)ViewBag.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-thang="@ViewBag.Thang" asp-route-nam="@ViewBag.Nam">@i</a></li>}</ul></nav>}
