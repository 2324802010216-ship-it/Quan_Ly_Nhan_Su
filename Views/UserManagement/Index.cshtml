@model List<UserViewModel>
@{ ViewData["Title"] = "Quản lý tài khoản"; }
<div class="page-header text-reveal-stagger"><h1><i class="fas fa-users-cog"></i> <span>Quản lý tài khoản</span></h1>
<a asp-action="Create" class="btn btn-primary btn-magnetic"><span class="btn-text"><i class="fas fa-plus"></i> Thêm</span></a></div>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0"><thead><tr><th>Email</th><th>Họ tên</th><th>Vai trò</th><th>Nhân viên</th><th></th></tr></thead>
<tbody>@foreach(var u in Model){<tr class="stagger-item"><td><strong>@u.Email</strong></td><td>@(u.HoTen??"—")</td>
<td><span class="badge @(u.Role=="Admin"?"bg-danger":u.Role=="HRManager"?"bg-primary":u.Role=="DeptManager"?"bg-warning":"bg-secondary")">@u.Role</span></td>
<td>@if(u.EmployeeMaNV!=null){<span>@u.EmployeeMaNV - @u.EmployeeName</span>}else{<span class="text-muted">—</span>}</td>
<td class="text-end"><a asp-action="Edit" asp-route-id="@u.Id" class="btn-action"><i class="fas fa-edit"></i></a>
<button class="btn-action danger" onclick="confirmDelete('@u.Email','@Url.Action("DeleteConfirmed",new{id=u.Id})')"><i class="fas fa-trash"></i></button></td></tr>}</tbody></table></div></div>
