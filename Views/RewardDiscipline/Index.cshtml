@model List<RewardDiscipline>
@{ ViewData["Title"] = "Khen thưởng / Kỷ luật"; }
<div class="page-header text-reveal-stagger"><h1><i class="fas fa-award"></i> <span>KT/KL</span></h1>
<a asp-action="Create" class="btn btn-primary btn-magnetic"><span class="btn-text"><i class="fas fa-plus"></i> Thêm</span></a></div>
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end">
    <div class="col-auto"><label>Lọc loại</label><select name="loai" class="form-select"><option value="">Tất cả</option>
    <option value="0" selected="@(ViewBag.Loai==0)">Khen thưởng</option><option value="1" selected="@(ViewBag.Loai==1)">Kỷ luật</option></select></div>
    <div class="col-auto"><button class="btn btn-primary"><i class="fas fa-filter"></i> Lọc</button></div>
</form></div></div>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0"><thead><tr><th>Ngày</th><th>NV</th><th>Loại</th><th>Số QĐ</th><th>Lý do</th><th>Số tiền</th><th></th></tr></thead>
<tbody>@foreach(var r in Model){<tr class="stagger-item"><td>@r.NgayQuyetDinh.ToString("dd/MM/yyyy")</td><td>@r.Employee.HoTen</td>
<td><span class="badge @(r.Loai==LoaiKhenThuongKyLuat.KhenThuong?"bg-success":"bg-danger")">@r.Loai</span></td>
<td>@(r.SoQuyetDinh??"—")</td><td>@r.LyDo</td><td>@r.SoTien.ToString("N0")₫</td>
<td class="text-end"><a asp-action="Edit" asp-route-id="@r.Id" class="btn-action"><i class="fas fa-edit"></i></a>
<button class="btn-action danger" onclick="confirmDelete('@r.Employee.HoTen','@Url.Action("DeleteConfirmed",new{id=r.Id})')"><i class="fas fa-trash"></i></button></td></tr>}</tbody></table></div></div>
@if((int?)ViewBag.TotalPages>1){<nav class="mt-3"><ul class="pagination justify-content-center">@for(int i=1;i<=(int)ViewBag.TotalPages;i++){<li class="page-item @(i==(int)ViewBag.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-loai="@ViewBag.Loai">@i</a></li>}</ul></nav>}
