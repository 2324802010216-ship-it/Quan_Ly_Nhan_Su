@model RewardDiscipline
@{ ViewData["Title"] = "Chi tiết KT/KL"; }
<div class="page-header"><h1><i class="fas fa-award"></i> Chi tiết Khen thưởng / Kỷ luật</h1>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fas fa-edit me-1"></i>Sửa</a></div>
<div class="card" style="max-width:600px"><div class="card-body">
    <p><strong>Nhân viên:</strong> <a asp-controller="Employee" asp-action="Details" asp-route-id="@Model.EmployeeId">@Model.Employee.HoTen</a></p>
    <p><strong>Loại:</strong>
        <span class="badge @(Model.Loai == LoaiKhenThuongKyLuat.KhenThuong ? "bg-success" : "bg-danger")">@Model.Loai</span>
    </p>
    <p><strong>Ngày quyết định:</strong> @Model.NgayQuyetDinh.ToString("dd/MM/yyyy")</p>
    <p><strong>Số quyết định:</strong> @(Model.SoQuyetDinh ?? "—")</p>
    <p><strong>Lý do:</strong> @Model.LyDo</p>
    <p><strong>Số tiền:</strong> <span class="fw-bold @(Model.Loai == LoaiKhenThuongKyLuat.KhenThuong ? "text-success" : "text-danger")">@Model.SoTien.ToString("N0") ₫</span></p>
    <hr />
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
</div></div>
