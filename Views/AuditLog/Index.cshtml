@model List<WebQuanLyNhanSu.Models.AuditLog>
@{ ViewData["Title"] = "Nhật ký hệ thống"; }
<div class="page-header"><h1><i class="fas fa-history"></i> Nhật ký hệ thống</h1></div>
<div class="card mb-3"><div class="card-body">
<form method="get" class="row g-2 align-items-end">
    <div class="col-md-3"><label class="form-label">Người dùng</label><input name="user" value="@ViewBag.User" class="form-control" placeholder="Tìm tên..."/></div>
    <div class="col-md-3"><label class="form-label">Đối tượng</label><select name="entity" class="form-select"><option value="">Tất cả</option>
    @if(ViewBag.Entities!=null){@foreach(string e in ViewBag.Entities){<option value="@e" selected="@(e==ViewBag.Entity)">@e</option>}}</select></div>
    <div class="col-md-2"><label class="form-label">Hành động</label><select name="action" class="form-select"><option value="">Tất cả</option>
    <option value="Create" selected="@("Create"==(string?)ViewBag.Action)">Tạo</option><option value="Update" selected="@("Update"==(string?)ViewBag.Action)">Sửa</option>
    <option value="Delete" selected="@("Delete"==(string?)ViewBag.Action)">Xóa</option><option value="Login" selected="@("Login"==(string?)ViewBag.Action)">Đăng nhập</option></select></div>
    <div class="col-md-2"><button class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i>Lọc</button></div>
</form></div></div>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0"><thead><tr><th style="width:150px">Thời gian</th><th>Người dùng</th><th>Hành động</th><th>Đối tượng</th><th>Chi tiết</th></tr></thead>
<tbody>@foreach(var log in Model){<tr class="stagger-item"><td class="text-muted">@log.Timestamp.ToString("dd/MM HH:mm:ss")</td><td>@log.UserName</td>
<td><span class="badge @(log.Action=="Create"?"bg-success":log.Action=="Update"?"bg-primary":log.Action=="Delete"?"bg-danger":"bg-info")">@log.Action</span></td>
<td>@log.EntityName @if(log.EntityId.HasValue){<small class="text-muted">#@log.EntityId</small>}</td><td class="text-muted">@(log.Details??"—")</td></tr>}</tbody></table></div></div>
@if((int?)ViewBag.TotalPages>1){<nav class="mt-3"><ul class="pagination justify-content-center">@for(int i=1;i<=(int)ViewBag.TotalPages;i++){<li class="page-item @(i==(int)ViewBag.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-user="@ViewBag.User" asp-route-entity="@ViewBag.Entity" asp-route-action="@ViewBag.Action">@i</a></li>}</ul></nav>}
