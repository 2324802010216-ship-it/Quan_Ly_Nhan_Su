@model Position
@{ ViewData["Title"] = "Chi tiết chức vụ"; }
<div class="page-header"><h1><i class="fas fa-user-tag"></i> @Model.TenChucVu</h1>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fas fa-edit me-1"></i>Sửa</a></div>
<div class="row g-4">
    <div class="col-md-4 stagger-item">
        <div class="card"><div class="card-body">
            <p><strong>Mô tả:</strong> @(Model.MoTa ?? "—")</p>
            <p><strong>Cấp bậc:</strong> <span class="badge bg-primary">@Model.CapBac / 10</span></p>
            <p><strong>Mức lương cơ sở:</strong> <span class="text-success fw-bold">@Model.MucLuongCoSo.ToString("N0") ₫</span></p>
            <p><strong>Số nhân viên:</strong> <span class="badge bg-info">@Model.Employees.Count</span></p>
        </div></div>
    </div>
    <div class="col-md-8 stagger-item">
        <div class="card"><div class="card-header"><h6>Nhân viên giữ chức vụ này</h6></div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead><tr><th>Mã NV</th><th>Họ tên</th><th>Phòng ban</th><th>Trạng thái</th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Employees)
                    {<tr><td>@e.MaNV</td><td><a asp-controller="Employee" asp-action="Details" asp-route-id="@e.Id">@e.HoTen</a></td><td>@e.Department?.TenPhongBan</td><td><span class="badge @(e.TrangThai==TrangThaiNhanVien.DangLamViec?"bg-success":"bg-secondary")">@e.TrangThai.GetDisplayName()</span></td></tr>}
                    @if(!Model.Employees.Any()){<tr><td colspan="4" class="text-center text-muted py-3">Chưa có nhân viên</td></tr>}
                </tbody>
            </table>
        </div></div>
    </div>
</div>
