@model Training
@{ ViewData["Title"] = Model.TenKhoaHoc; }
<div class="page-header"><h1><i class="fas fa-graduation-cap"></i> @Model.TenKhoaHoc</h1><div class="d-flex gap-2">
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="fas fa-edit me-1"></i>Sửa</a>
<button class="btn btn-outline-danger" onclick="confirmDelete('@Model.TenKhoaHoc','@Url.Action("DeleteConfirmed",new{id=Model.Id})')"><i class="fas fa-trash me-1"></i>Xóa</button></div></div>
<div class="row g-4"><div class="col-md-4 stagger-item"><div class="card"><div class="card-body">
    <p><strong>Ngày:</strong> @Model.NgayBatDau.ToString("dd/MM") → @Model.NgayKetThuc.ToString("dd/MM/yyyy")</p>
    <p><strong>Địa điểm:</strong> @(Model.DiaDiem??"—")</p><p><strong>Người ĐT:</strong> @(Model.NguoiDaoTao??"—")</p>
    <p><strong>Chi phí:</strong> @Model.ChiPhi.ToString("N0")₫</p>
    @if(Model.MoTa != null){<hr/><p>@Model.MoTa</p>}
</div></div>
<!-- ENROLL FORM -->
<div class="card mt-3"><div class="card-header"><h6><i class="fas fa-user-plus me-1"></i>Đăng ký học viên</h6></div><div class="card-body">
    <form asp-action="Enroll" method="post" class="d-flex gap-2">
        <input type="hidden" name="trainingId" value="@Model.Id" />
        <select name="employeeId" class="form-select" required>
            <option value="">-- Chọn nhân viên --</option>
            @foreach(var e in (List<WebQuanLyNhanSu.Models.Employee>)ViewBag.Employees)
            {<option value="@e.Id">@e.MaNV - @e.HoTen</option>}
        </select>
        <button class="btn btn-primary"><i class="fas fa-plus"></i></button>
    </form>
</div></div>
</div>
<div class="col-md-8 stagger-item"><div class="card"><div class="card-header"><h6>Học viên (@Model.TrainingEmployees.Count)</h6></div><div class="card-body p-0">
<table class="table table-hover mb-0"><thead><tr><th>NV</th><th>Kết quả</th><th>Điểm</th><th></th></tr></thead>
<tbody>
@if(!Model.TrainingEmployees.Any()){<tr><td colspan="4" class="text-center text-muted py-3">Chưa có học viên</td></tr>}
@foreach(var te in Model.TrainingEmployees){<tr><td>@te.Employee.HoTen</td><td>@(te.KetQua??"—")</td><td>@(te.DiemSo?.ToString("F1")??"—")</td>
<td><form asp-action="UpdateResult" asp-route-id="@te.Id" method="post" class="d-flex gap-1"><input name="ketQua" value="@te.KetQua" class="form-control form-control-sm" style="width:100px" placeholder="Đạt/Không"/>
<input name="diemSo" value="@te.DiemSo" type="number" step="0.1" class="form-control form-control-sm" style="width:70px"/>
<button class="btn btn-sm btn-primary"><i class="fas fa-save"></i></button></form>
<form asp-action="Unenroll" asp-route-id="@te.Id" method="post" style="display:inline"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Hủy đăng ký?')"><i class="fas fa-user-minus"></i></button></form></td></tr>}</tbody></table></div></div></div></div>
