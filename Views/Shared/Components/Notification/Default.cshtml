@model WebQuanLyNhanSu.ViewComponents.NotificationViewModel
<div class="notification-bell dropdown">
    <button data-bs-toggle="dropdown" aria-expanded="false"><i class="fas fa-bell"></i>
        @if (Model.Count > 0) { <span class="badge-count">@Model.Count</span> }
    </button>
    <div class="dropdown-menu dropdown-menu-end p-0" style="width:340px;max-height:400px;overflow-y:auto">
        <div class="px-3 py-2 border-bottom"><strong><i class="fas fa-bell me-1"></i>Thông báo</strong></div>
        @if (Model.ExpiringContracts.Any())
        {
            <div class="px-3 py-1"><small class="text-muted fw-bold">HĐ sắp hết hạn</small></div>
            @foreach (var c in Model.ExpiringContracts)
            {
                <a href="/Contract/Details/@c.Id" class="dropdown-item py-2" style="white-space:normal">
                    <i class="fas fa-file-contract text-warning me-2"></i>
                    <span>@c.Employee.HoTen — <strong>@c.MaHopDong</strong> hết @c.NgayKetThuc?.ToString("dd/MM")</span>
                </a>
            }
        }
        @if (Model.PendingLeaves.Any())
        {
            <div class="px-3 py-1 border-top"><small class="text-muted fw-bold">Đơn nghỉ chờ duyệt</small></div>
            @foreach (var l in Model.PendingLeaves)
            {
                <a href="/LeaveRequest/Details/@l.Id" class="dropdown-item py-2" style="white-space:normal">
                    <i class="fas fa-calendar-minus text-info me-2"></i>
                    <span>@l.Employee.HoTen — @l.LoaiNghi.GetDisplayName() @l.NgayBatDau.ToString("dd/MM")-@l.NgayKetThuc.ToString("dd/MM")</span>
                </a>
            }
        }
        @if (Model.Count == 0)
        {
            <div class="px-3 py-4 text-center text-muted"><i class="fas fa-check-circle me-1"></i>Không có thông báo mới</div>
        }
    </div>
</div>
