@model List<Department>
@{ ViewData["Title"] = "Phòng ban"; }
<div class="page-header text-reveal-stagger">
    <h1><i class="fas fa-building"></i> <span>Quản lý Phòng ban</span></h1>
    <a asp-action="Create" class="btn btn-primary btn-magnetic"><span class="btn-text"><i class="fas fa-plus"></i> Thêm mới</span></a>
</div>
<div class="card mb-3"><div class="card-body py-2">
<form method="get" class="row g-2 align-items-center">
    <div class="col-md-4"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm tên phòng ban..." /></div>
    <div class="col-auto"><button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i>Tìm</button></div>
    @if(ViewBag.Search != null){<div class="col-auto"><a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-times me-1"></i>Xóa lọc</a></div>}
</form>
</div></div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>Tên phòng ban</th><th>Trưởng phòng</th><th>Số NV</th><th>Ngày thành lập</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr class="stagger-item">
                        <td>@d.Id</td>
                        <td><strong>@d.TenPhongBan</strong></td>
                        <td>@(d.TruongPhong?.HoTen ?? "—")</td>
                        <td><span class="badge bg-primary">@d.Employees.Count</span></td>
                        <td>@d.NgayThanhLap.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@d.Id" class="btn-action" data-tooltip="Chi tiết"><i class="fas fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn-action" data-tooltip="Sửa"><i class="fas fa-edit"></i></a>
                            <button class="btn-action danger" data-tooltip="Xóa" onclick="confirmDelete('@d.TenPhongBan', '@Url.Action("DeleteConfirmed", new { id = d.Id })')"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if((int?)ViewBag.TotalPages>1){<nav class="mt-3"><ul class="pagination justify-content-center">@for(int i=1;i<=(int)ViewBag.TotalPages;i++){<li class="page-item @(i==(int)ViewBag.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a></li>}</ul></nav>}
